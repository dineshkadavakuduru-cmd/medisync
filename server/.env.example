# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medisync

# Server
PORT=3001
ENABLE_SIMULATOR=true

# Gemini AI API Key (optional — enables enhanced clinical summaries)
# Get your key from https://aistudio.google.com/app/apikey
# If not set, the app gracefully falls back to rule-based summaries
GEMINI_API_KEY=
