# Database
# Optional. No database is needed for demo boot. Supply your own configured URL
# only for measured vitals or the explicit db:setup/db:seed commands.
DATABASE_URL=
VITALS_MODE=demo

# Server
PORT=3001
ENABLE_SIMULATOR=true

# Single-process local persistence; defaults are server/data/*.json.
# DIAGNOSTICS_STORE_PATH=
# REFERRALS_STORE_PATH=
# Authentication, ABDM, SMS and push providers are unconfigured.

# Gemini AI API Key (optional — enables enhanced clinical summaries)
# Get your key from https://aistudio.google.com/app/apikey
# If not set, the app gracefully falls back to rule-based summaries
GEMINI_API_KEY=
