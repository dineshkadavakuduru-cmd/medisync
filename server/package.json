{
  "name": "medisync-server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "test:start": "tsx test/start-smoke.ts",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx src/database/setup.ts",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/websocket": "^10.0.0",
    "fastify": "^4.26.0",
    "pg": "^8.11.0",
    "postgres": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
